    "                    color=bar_colors, alpha=0.85)\n",
    "axes[0].axvline(0,    color='white',  lw=1, alpha=0.5)\n",
    "axes[0].axvline( 0.3, color='yellow', lw=1.5, ls=':', label='|r|=0.3 기준')\n",
