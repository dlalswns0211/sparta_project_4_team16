    "### 4-9. 시차상관관계 (Sensor → RUL, lag 0~15)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "28c00e89",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 2200x700 with 3 Axes>"
