    "# 클러스터별 상관계수 평균\n",
    "rul_corr_before = pd.concat(cluster_rul_corrs, axis=1).mean(axis=1).sort_values()\n",
    "\n",
    "print(f'클러스터 수: {len(cluster_rul_corrs)}개  |  센서 수: {len(rul_corr_before)}개')\n",
