    "print('=== [추가] val_eval 생성 (수명 50~90% 절단, seed=42) ===')\n",
    "\n",
    "# ── valid_s4에 OHE 컬럼 동기화 (없으면 추가) ─────────────────────\n",
    "OHE_COLS_VE = [f'cluster_{i}' for i in range(N_CLUSTERS)]  # N_CLUSTERS=6 기준\n",
    "for _col in OHE_COLS_VE:\n",
    "    if _col not in valid_s4.columns:\n",
    "        # op_cluster 기준으로 OHE 재생성\n",
    "        _ohe = pd.get_dummies(valid_s4['op_cluster'], prefix='cluster', dtype=float)\n",
    "        for _c in OHE_COLS_VE:\n",
    "            valid_s4[_c] = _ohe[_c].values if _c in _ohe.columns else 0.0\n",
    "        print(f'✅ valid_s4에 OHE 컬럼 {len(OHE_COLS_VE)}개 추가됨')\n",
    "        break\n",
    "\n",
    "WINDOW_SIZE_VE = 20\n",
    "rng = np.random.RandomState(42)\n",
    "\n",
    "ml_val_eval_rows, dl_val_eval_X, dl_val_eval_y = [], [], []\n",
    "\n",
    "for uid in np.sort(valid_s4['unit_nr'].unique()):\n",
    "    udf       = valid_s4[valid_s4['unit_nr']==uid].sort_values('time_cycles').reset_index(drop=True)\n",
    "    n         = len(udf)\n",
    "    cut_idx   = max(WINDOW_SIZE_VE, min(int(n * rng.uniform(0.5, 0.9)), n))\n",
    "\n",
    "    # ML val_eval: valid_ml(파생변수 포함)에서 동일 time_cycles 행 추출\n",
    "    cut_time     = udf.iloc[cut_idx - 1]['time_cycles']\n",
    "    ml_uid_df    = valid_ml[valid_ml['unit_nr'] == uid].sort_values('time_cycles').reset_index(drop=True)\n",
    "    ml_match     = ml_uid_df[ml_uid_df['time_cycles'] == cut_time]\n",
    "    if len(ml_match) > 0:\n",
    "        ml_val_eval_rows.append(ml_match.iloc[0].copy())\n",
    "    else:\n",
    "        # fallback: 인덱스 기준\n",
    "        ml_val_eval_rows.append(ml_uid_df.iloc[min(cut_idx - 1, len(ml_uid_df) - 1)].copy())\n",
    "\n",
    "    # DL_FEATURES 중 valid_s4에 실제 존재하는 컬럼만 사용\n",
    "    # (FD002/004: cluster_OHE가 DL_FEATURES에 포함되나 valid_s4에 없을 수 있음)\n",
    "    _avail_feats = [f for f in DL_FEATURES if f in udf.columns]\n",
    "    data   = udf[_avail_feats].values.astype(np.float32)\n",
    "    window = data[max(0, cut_idx - WINDOW_SIZE_VE):cut_idx]\n",
    "    if len(window) < WINDOW_SIZE_VE:\n",
    "        pad    = np.zeros((WINDOW_SIZE_VE - len(window), len(_avail_feats)), dtype=np.float32)\n",
    "        window = np.vstack([pad, window])\n",
    "    dl_val_eval_X.append(window)\n",
    "    dl_val_eval_y.append(float(udf['RUL'].iloc[cut_idx - 1]))\n",
