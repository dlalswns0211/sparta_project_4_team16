    "src_n = subtrain_s4.copy()\n",
    "\n",
    "if 'RUL' not in src_n.columns:\n",
    "    mc = src_n.groupby('unit_nr')['time_cycles'].max().rename('max_c')\n",
    "    src_n = src_n.join(mc, on='unit_nr')\n",
    "    src_n['RUL'] = src_n['max_c'] - src_n['time_cycles']\n",
    "    src_n.drop(columns=['max_c'], inplace=True)\n",
    "\n",
    "# PCA 입력 컬럼 검증\n",
    "missing = [c for c in USEFUL_SENSORS if c not in src_n.columns]\n",
    "assert not missing, f'PCA 입력 센서 컬럼 누락: {missing}'\n",
    "assert 'op_cluster' in src_n.columns, 'op_cluster 컬럼이 없습니다. 클러스터링 셀을 먼저 실행하세요.'\n",
    "assert 'RUL' in src_n.columns, 'RUL 컬럼이 없습니다. RUL 생성 셀을 먼저 실행하세요.'\n",
    "\n",
    "# 샘플 5000개로 다운샘플\n",
    "sample = src_n.sample(min(5000, len(src_n)), random_state=42)\n",
    "\n",
    "pca = PCA(n_components=2, random_state=42)\n",
    "Z = pca.fit_transform(sample[USEFUL_SENSORS])\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n",
    "\n",
    "sc = axes[0].scatter(\n",
    "    Z[:, 0], Z[:, 1],\n",
    "    c=sample['RUL'],\n",
    "    cmap='viridis',\n",
    "    s=8,\n",
    "    alpha=0.6\n",
    ")\n",
    "plt.colorbar(sc, ax=axes[0], label='RUL')\n",
    "axes[0].set_title(f'PCA — colored by RUL  (var={pca.explained_variance_ratio_.sum():.2f})')\n",
    "axes[0].set_xlabel('PC1')\n",
    "axes[0].set_ylabel('PC2')\n",
    "\n",
    "for c in range(N_CLUSTERS):\n",
    "    m = sample['op_cluster'] == c\n",
    "    if m.sum() == 0:\n",
    "        continue\n",
    "    axes[1].scatter(\n",
    "        Z[m, 0], Z[m, 1],\n",
    "        c=CLUSTER_COLORS[c],\n",
    "        s=8,\n",
    "        alpha=0.5,\n",
    "        label=f'C{c}'\n",
    "    )\n",
